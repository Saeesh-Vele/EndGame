# Copy this file to .env.local and fill in your values.

# --- Supabase -------------------------------------------------------------
# Project Settings > API. The anon key is safe to expose — it's inlined into
# the client bundle and RLS is what actually protects the data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site -----------------------------------------------------------------
# Absolute origin, no trailing slash. Used to build links in outgoing emails
# ("View in dashboard"), which have no request context to infer it from.
# Falls back to http://localhost:3000 when unset.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email) -----------------------------------------
# https://resend.com/api-keys. Server-only — deliberately NOT prefixed with
# NEXT_PUBLIC_, so it never reaches the browser.
#
# Leaving RESEND_API_KEY blank is supported: the app runs normally and every
# send is skipped with a one-time console warning. That's the intended
# development setup.

RESEND_API_KEY=

# The From address on every outgoing email. Its domain must be verified in
# Resend first (https://resend.com/domains) or sends are rejected.
# Format: "Display Name <address@your-domain>".
# Resend's onboarding@resend.dev works for testing, but only delivers to the
# address that owns the Resend account.

RESEND_FROM_EMAIL="StayVilla <noreply@stayvilla.in>"
